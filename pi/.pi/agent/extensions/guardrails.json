{
  "enabled": true,
  "features": {
    "policies": true,
    "permissionGate": true
  },
  "permissionGate": {
    "requireConfirmation": true,
    "explainCommands": true,
    "customPatterns": [
      {
        "pattern": "terraform apply",
        "description": "Terraform infrastructure changes"
      },
      {
        "pattern": "git push --force",
        "description": "git force push"
      },
      {
        "pattern": "kubectl delete",
        "description": "delete kube assets"
      },
      {
        "pattern": "git rebase",
        "description": "git rebase rewrites commit history"
      }
    ]
  },
  "policies": {
    "rules": [
      {
        "id": "env-files",
        "description": "Protect env files containing secrets",
        "patterns": [
          {
            "pattern": "^\\.env(\\..+)?$",
            "regex": true
          }
        ],
        "allowedPatterns": [
          {
            "pattern": "^\\.env\\.example$",
            "regex": true
          }
        ],
        "protection": "noAccess",
        "onlyIfExists": true,
        "enabled": true
      },
      {
        "id": "aws-credentials",
        "description": "Block AWS credentials and config files",
        "patterns": [
          {
            "pattern": ".aws/credentials"
          },
          {
            "pattern": ".aws/config"
          }
        ],
        "protection": "noAccess",
        "onlyIfExists": true,
        "enabled": true
      }
    ]
  },
  "version": "0.8.0-20260228"
}
