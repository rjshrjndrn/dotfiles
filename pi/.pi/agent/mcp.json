{
  "mcpServers": {
    "exa": {
      "url": "https://mcp.exa.ai/mcp",
      "lifecycle": "lazy"
    },
    "yahoo": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/Alex2Yang97/yahoo-finance-mcp",
        "yahoo-finance-mcp"
      ],
      "lifecycle": "lazy"
    },
    "notion": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://mcp.notion.com/mcp"
      ],
      "lifecycle": "lazy"
    },
    "cc": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp@latest"
      ],
      "lifecycle": "lazy"
    },
    "linear": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://mcp.linear.app/mcp"
      ],
      "lifecycle": "lazy"
    },
    "lp": {
      "command": "lightpanda",
      "args": [
        "mcp"
      ],
      "lifecycle": "lazy"
    },
    "tinyfish": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://agent.tinyfish.ai/mcp"
      ],
      "lifecycle": "lazy"
    },
    "tinyfish-docs": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://docs.tinyfish.ai/mcp"
      ],
      "lifecycle": "lazy"
    }
  }
}
