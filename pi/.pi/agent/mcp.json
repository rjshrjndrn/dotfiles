{
  "mcpServers": {
    "exa": {
      "url": "https://mcp.exa.ai/mcp",
      "lifecycle": "eager"
    },
    "cc": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp@latest"
      ],
      "lifecycle": "eager"
    },
    "linear": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://mcp.linear.app/sse"
      ],
      "lifecycle": "lazy"
    },
    "context-mode": {
      "command": "context-mode",
      "lifecycle": "eager"
    }
  }
}
