{
  "mcpServers": {
    "exa": {
      "url": "https://mcp.exa.ai/mcp",
      "headers": {
        "x-api-key": "${EXA_API_KEY}"
      }
    },
    "yahoo": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/Alex2Yang97/yahoo-finance-mcp",
        "yahoo-finance-mcp"
      ],
      "exposure": "deferred"
    },
    "alpaca": {
      "command": "uvx",
      "args": [
        "alpaca-mcp-server"
      ],
      "env": {
        "ALPACA_API_KEY": "${APCA_API_KEY_ID}",
        "ALPACA_SECRET_KEY": "${APCA_API_SECRET_KEY}"
      },
      "exposure": "deferred"
    },
    "notion": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://mcp.notion.com/mcp"
      ],
      "exposure": "deferred"
    },
    "cc": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp@latest"
      ],
      "exposure": "deferred"
    },
    "linear": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://mcp.linear.app/mcp"
      ],
      "exposure": "deferred"
    },
    "tinyfish": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://agent.tinyfish.ai/mcp"
      ],
      "exposure": "deferred"
    },
    "tinyfish-docs": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://docs.tinyfish.ai/mcp"
      ],
      "exposure": "deferred"
    },
    "drawio": {
      "command": "npx",
      "args": [
        "-y",
        "drawio-mcp-server",
        "--editor"
      ],
      "exposure": "deferred"
    },
    "dolly": {
      "command": "dolly",
      "args": [
        "mcp"
      ],
      "exposure": "deferred"
    },
    "slack": {
      "command": "npx",
      "args": [
        "-y",
        "slack-mcp-server@latest",
        "--transport",
        "stdio"
      ],
      "env": {
        "SLACK_MCP_XOXP_TOKEN": "${SLACK_MCP_XOXP_TOKEN}"
      },
      "exposure": "deferred"
    }
  }
}
