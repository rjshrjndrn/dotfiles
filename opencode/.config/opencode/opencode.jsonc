{
  "$schema": "https://opencode.ai/config.json",
  "tools": {
    "linear*": false
  },
  "permission": {
    "bash": {
      "*": "ask",
    }
  },
  "model": "anthropic/claude-haiku-4-5",
  "default_agent": "thinker",
  "agent": {
    "thinker": {
      "model": "anthropic/claude-opus-4-5",
    },
    "coder-v2": {
      "model": "anthropic/claude-sonnet-4-6",
      "permission": {
        "bash": {
          "*": "allow",
          "/tmp/*": "allow",
          "git *": "allow",
          "ls *": "allow",
          "find *": "allow",
          "mkdir *": "allow",
          "grep *": "allow",
          "head *": "allow",
          // priority rules at last
          "git push *": "ask",
          "rm *": "ask", // find and other tools can embed rm like -exec
          "* rm *": "ask", // find and other tools can embed rm like -exec
          "* delete *": "ask",
          // "aws *": "ask",
          // "* aws *": "ask",
          // "az *": "ask",
          "* az *": "ask",
          "scw *": "ask",
          "* scw *": "ask",
        }
      },
    },
    "coder": {
      "permission": {
        "bash": {
          "*": "allow",
          "/tmp/*": "allow",
          "git *": "allow",
          "ls *": "allow",
          "find *": "allow",
          "mkdir *": "allow",
          "grep *": "allow",
          "head *": "allow",
          // priority rules at last
          "git push *": "ask",
          "rm *": "ask", // find and other tools can embed rm like -exec
          "* rm *": "ask", // find and other tools can embed rm like -exec
          "* delete *": "ask",
          // "aws *": "ask",
          // "* aws *": "ask",
          // "az *": "ask",
          "* az *": "ask",
          "scw *": "ask",
          "* scw *": "ask",
        }
      },
    },
    "fetch": {},
    "build": {
      "disable": true
    },
    "linear": {
      "tools": {
        "linear*": true
      }
    },
    "plan": {
      "disable": true
    }
  },
  "plugin": [
    "opencode-anthropic-auth@latest",
    "opencode-antigravity-auth@latest"
    // "opencode-mem"
    // "opencode-openai-codex-auth",
    // "oh-my-opencode",
    // "opencode-antigravity-auth@1.2.8"
  ],
  "mcp": {
    "financial-datasets": {
      "enabled": false,
      "type": "local",
      "command": [
        "sh",
        "-c",
        "exec uv --directory ~/Documents/projects/stocks/mcp-servers/financial-datasets run server.py"
      ]
    },
    "yahoo-datasets": {
      "type": "local",
      "command": [
        "sh",
        "-c",
        "exec uv --directory ~/Documents/projects/stocks/mcp-servers/yahoo-finance-mcp run server.py"
      ]
    },
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp",
      "headers": {
        "x-api-key": "{env:EXA_API_KEY}"
      }
    },
    "cc": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    },
    "linear": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "mcp-remote",
        "https://mcp.linear.app/sse"
      ]
    }
  },
}
