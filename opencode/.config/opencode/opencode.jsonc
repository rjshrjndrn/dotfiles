{
  "$schema": "https://opencode.ai/config.json",
  "theme": "lucent-orng",
  "formatter": false,
  "tools": {
    "linear*": false
  },
  "keybinds": {
    "leader": "ctrl+space",
    "editor_open": "ctrl+e",
    "messages_page_up": "ctrl+u",
    "agent_cycle": "ctrl+a",
    "messages_page_down": "ctrl+d",
    "model_cycle_recent": "ctrl+n",
    "model_cycle_recent_reverse": "ctrl+p",
    "input_newline": "shift+return,ctrl+return,alt+return,ctrl+j",
  },
  "permission": {
    "bash": {
      "*": "ask",
    },
    "lsp": "allow",
  },
  "provider": {
    "omniroute": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OmniRoute",
      "options": {
        "baseURL": "http://localhost:20128/v1"
      },
      "models": {
        "claude/claude-sonnet-4-6": {
          "name": "Claude Sonnet 4"
        },
        "claude/claude-opus-4-6": {
          "name": "Claude Opus 4.6"
        }
      }
    }
  },
  "model": "anthropic/claude-haiku-4-5",
  "default_agent": "coder-v2",
  "agent": {
    "coder-v2": {
      "prompt": "use caveman skill.Your job is to tell me howto. Don't do without explicit ask from user. Use exa for infromation from internet, and cc for document references.",
      "model": "anthropic/claude-sonnet-4-6",
      "permission": {
        "bash": {
          "*": "allow",
          "/tmp/*": "allow",
          "git *": "allow",
          "ls *": "allow",
          "find *": "allow",
          "mkdir *": "allow",
          "grep *": "allow",
          "head *": "allow",
          // priority rules at last
          "git push *": "ask",
          "rm *": "ask", // find and other tools can embed rm like -exec
          "* rm *": "ask", // find and other tools can embed rm like -exec
          "* delete *": "ask",
          // "aws *": "ask",
          // "* aws *": "ask",
          // "az *": "ask",
          "* az *": "ask",
          "scw *": "ask",
          "* scw *": "ask",
        },
      },
      "thinker": {
        "model": "anthropic/claude-opus-4-5",
      },
      "coder": {
        "permission": {
          "bash": {
            "*": "allow",
            "/tmp/*": "allow",
            "git *": "allow",
            "ls *": "allow",
            "find *": "allow",
            "mkdir *": "allow",
            "grep *": "allow",
            "head *": "allow",
            // priority rules at last
            "git push *": "ask",
            "rm *": "ask", // find and other tools can embed rm like -exec
            "* rm *": "ask", // find and other tools can embed rm like -exec
            "* delete *": "ask",
            // "aws *": "ask",
            // "* aws *": "ask",
            // "az *": "ask",
            "* az *": "ask",
            "scw *": "ask",
            "* scw *": "ask",
          }
        },
      },
      "fetch": {},
      "build": {
        "disable": true
      },
      "linear": {
        "tools": {
          "linear*": true
        }
      },
      "plan": {
        "disable": true
      }
    }
  },
  "plugin": [
    // "opencode-anthropic-auth@latest",
    "@ex-machina/opencode-anthropic-auth@v1.5.1",
    "opencode-acm@0.5.0",
    // "opencode-antigravity-auth@latest",
    // "context-mode"
    // "opencode-mem"
    // "opencode-openai-codex-auth",
    // "oh-my-opencode",
    // "opencode-antigravity-auth@1.2.8"
  ],
  "mcp": {
    "context-mode": {
      "type": "local",
      "command": [
        "context-mode"
      ]
    },
    "financial-datasets": {
      "enabled": false,
      "type": "local",
      "command": [
        "sh",
        "-c",
        "exec uv --directory ~/Documents/projects/stocks/mcp-servers/financial-datasets run server.py"
      ]
    },
    "yahoo-datasets": {
      "type": "local",
      "command": [
        "sh",
        "-c",
        "exec uv --directory ~/Documents/projects/stocks/mcp-servers/yahoo-finance-mcp run server.py"
      ]
    },
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp",
      "headers": {
        "x-api-key": "{env:EXA_API_KEY}"
      }
    },
    "cc": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    },
    "gitnexus": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "gitnexus@latest",
        "mcp"
      ]
    },
    "linear": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "mcp-remote",
        "https://mcp.linear.app/sse"
      ]
    }
  },
}
