{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "coder": {},
    // Disabling else, this will be the first agent on lauch
    "build": {
      "disable": true
    },
    "plan": {
      "disable": true
    },
  },
  // "tui": {
  //   "scroll_speed": 10
  // },
  "permission": {
    "bash": "ask"
  },
  "plugin": [
    // https://github.com/numman-ali/opencode-openai-codex-auth
    "opencode-openai-codex-auth"
  ],
  // https://mcpmarket.com: to see mcps
  "mcp": {
    // "financial-datasets": {
    //   "type": "local",
    //   "command": [
    //     "sh",
    //     "-c",
    //     "exec uv --directory ~/Documents/projects/stocks/mcp-servers/financial-datasets run server.py"
    //   ]
    // },
    "yahoo-datasets": {
      "type": "local",
      "command": [
        "sh",
        "-c",
        "exec uv --directory ~/Documents/projects/stocks/mcp-servers/yahoo-finance-mcp run server.py"
      ]
    },
    "exa-web-search": {
      "type": "remote",
      // "environment": {
      //   "EXA_API_KEY": ""
      // },
      "url": "https://mcp.exa.ai/mcp"
    },
    // context7 library docs
    // do this, that etc. use cc
    "cc": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    }
  }
}
