{
  "$schema": "https://opencode.ai/config.json",
  "theme": "everforest",
  "tools": {
    "linear*": false
  },
  "keybinds": {
    "leader": "ctrl+space",
    "editor_open": "ctrl+e",
    "messages_page_up": "ctrl+u",
    // "agent_cycle": "ctrl+a",
    "messages_page_down": "ctrl+d",
    "model_cycle_recent": "ctrl+n",
    "model_cycle_recent_reverse": "ctrl+p",
  },
  "permission": {
    "bash": {
      "*": "ask",
    }
  },
  "default_agent": "thinker",
  "agent": {
    "thinker": {},
    "coder": {
      "permission": {
        "bash": {
          "*": "ask",
          "git push *": "ask",
          "* rm *": "ask", // find and other tools can embed rm like -exec
          "git *": "allow",
          "ls *": "allow",
          "find *": "allow",
          "mkdir *": "allow",
          "grep *": "allow",
          "head *": "allow",
        }
      },
    },
    "fetch": {},
    "build": {
      "disable": true
    },
    "linear": {
      "mode": "subagent",
      "prompt": "Never use emojis. If you are asked to create linear tasks. Only create issue description not resolution, and keep it short and concise. Keep the status in todo, if you're creating the task and assign it to me.",
      "tools": {
        "linear*": true
      }
    },
    "plan": {
      "disable": true
    }
  },
  "plugin": [
    // "opencode-openai-codex-auth",
    // "oh-my-opencode",
    // "opencode-antigravity-auth@1.2.8"
  ],
  "mcp": {
    "financial-datasets": {
      "enabled": false,
      "type": "local",
      "command": [
        "sh",
        "-c",
        "exec uv --directory ~/Documents/projects/stocks/mcp-servers/financial-datasets run server.py"
      ]
    },
    "yahoo-datasets": {
      "type": "local",
      "command": [
        "sh",
        "-c",
        "exec uv --directory ~/Documents/projects/stocks/mcp-servers/yahoo-finance-mcp run server.py"
      ]
    },
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp",
      "headers": {
        "x-api-key": "{env:EXA_API_KEY}"
      }
    },
    "cc": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    },
    "linear": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "mcp-remote",
        "https://mcp.linear.app/sse"
      ]
    }
  },
}
