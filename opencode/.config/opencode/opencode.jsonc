{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    // https://github.com/numman-ali/opencode-openai-codex-auth
    "opencode-openai-codex-auth"
  ],
  "agent": {
    "stock": {
      "description": "Description of the agent",
      "prompt": "Be detailed in calculations.",
      "tools": {
        "write": true,
        "bash": false
      }
    }
  },
  // https://mcpmarket.com: to see mcps
  "mcp": {
    // "financial-datasets": {
    //   "type": "local",
    //   "command": [
    //     "sh",
    //     "-c",
    //     "exec uv --directory ~/Documents/projects/stocks/mcp-servers/financial-datasets run server.py"
    //   ]
    // },
    "yahoo-datasets": {
      "type": "local",
      "command": [
        "sh",
        "-c",
        "exec uv --directory ~/Documents/projects/stocks/mcp-servers/yahoo-finance-mcp run server.py"
      ]
    },
    "exa-web-search": {
      "type": "local",
      // "environment": {
      //   "EXA_API_KEY": ""
      // },
      "command": [
        "npx",
        "-y",
        "mcp-remote",
        "https://mcp.exa.ai/mcp"
      ]
    }
  }
}
