#!/data/data/com.termux/files/usr/bin/bash
# vim: set ft=bash:
#
# termux-url-opener - Handle shared URLs from various services
#
# Setup:
#   pkg update && pkg install yt-dlp ffmpeg
#   termux-setup-storage
#   mkdir -p ~/bin
#   cp termux-url-opener ~/bin/
#   chmod +x ~/bin/termux-url-opener
#
# Supported: YouTube, Tidal (more to come)
#

set -uo pipefail

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

# Output directories
DOWNLOAD_BASE="$HOME/storage/shared/Download/termux"

log_info() { echo -e "${BLUE}[*]${NC} $1"; }
log_success() { echo -e "${GREEN}[+]${NC} $1"; }
log_warn() { echo -e "${YELLOW}[!]${NC} $1"; }
log_error() { echo -e "${RED}[-]${NC} $1" >&2; }

wait_exit() {
  echo ""
  read -rp "Press Enter to close..."
  exit "${1:-1}"
}

# Check if storage is accessible
check_storage() {
  if [[ ! -d "$HOME/storage/shared" ]]; then
    log_error "Storage not accessible"
    log_info "Run: termux-setup-storage"
    wait_exit 1
  fi
}

# Check if commands exist
require_cmds() {
  local missing=()
  for cmd in "$@"; do
    command -v "$cmd" &>/dev/null || missing+=("$cmd")
  done
  if [[ ${#missing[@]} -gt 0 ]]; then
    log_error "Missing: ${missing[*]}"
    log_info "Run: pkg install ${missing[*]}"
    wait_exit 1
  fi
}

# ==============================================================================
# YouTube
# ==============================================================================

yt_extract_video_id() {
  local url="$1"
  local video_id=""

  # Strip tracking params
  url="${url%%\?si=*}"
  url="${url%%&si=*}"
  url="${url%%\?feature=*}"
  url="${url%%&feature=*}"

  # Regex patterns (variables avoid Bash quoting issues)
  local re_short='youtu\.be/([a-zA-Z0-9_-]{11})'
  local re_shorts='youtube\.com/shorts/([a-zA-Z0-9_-]{11})'
  local re_watch='youtube\.com/watch\?v=([a-zA-Z0-9_-]{11})'
  local re_param='[?&]v=([a-zA-Z0-9_-]{11})'
  local re_v='youtube\.com/v/([a-zA-Z0-9_-]{11})'
  local re_embed='youtube\.com/embed/([a-zA-Z0-9_-]{11})'

  if [[ "$url" =~ $re_short ]]; then
    video_id="${BASH_REMATCH[1]}"
  elif [[ "$url" =~ $re_shorts ]]; then
    video_id="${BASH_REMATCH[1]}"
  elif [[ "$url" =~ $re_watch ]]; then
    video_id="${BASH_REMATCH[1]}"
  elif [[ "$url" =~ $re_param ]]; then
    video_id="${BASH_REMATCH[1]}"
  elif [[ "$url" =~ $re_v ]]; then
    video_id="${BASH_REMATCH[1]}"
  elif [[ "$url" =~ $re_embed ]]; then
    video_id="${BASH_REMATCH[1]}"
  fi

  echo "$video_id"
}

yt_is_short() {
  local url="$1"
  local video_id="$2"
  local re_shorts='youtube\.com/shorts/'
  local re_number='^[0-9]+(\.[0-9]+)?$'

  [[ "$url" =~ $re_shorts ]] && return 0

  local duration
  duration=$(yt-dlp --no-warnings --print duration "https://www.youtube.com/watch?v=$video_id" 2>/dev/null || echo "999")
  [[ "$duration" =~ $re_number ]] && [[ "${duration%.*}" -le 60 ]] && return 0

  return 1
}

yt_download() {
  local video_id="$1"
  local is_short="$2"
  local base_dir="$DOWNLOAD_BASE/yt"
  local output_dir
  local yt_url="https://www.youtube.com/watch?v=$video_id"

  if [[ "$is_short" == "true" ]]; then
    output_dir="$base_dir/shorts"
    log_info "Type: YouTube Short"
  else
    output_dir="$base_dir/videos"
    log_info "Type: Regular Video"
  fi
  mkdir -p "$output_dir"

  local title
  title=$(yt-dlp --no-warnings --print title "$yt_url" 2>/dev/null || echo "Unknown")
  log_info "Title: $title"

  echo ""
  log_info "Downloading in max resolution..."
  echo ""

  yt-dlp \
    --no-playlist \
    --retries 3 \
    --fragment-retries 3 \
    -f "bestvideo[ext=mp4]+bestaudio[ext=m4a]/bestvideo+bestaudio/best" \
    --merge-output-format mp4 \
    --embed-thumbnail \
    --embed-metadata \
    --parse-metadata "webpage_url:%(meta_comment)s" \
    --restrict-filenames \
    --no-mtime \
    --progress \
    -o "$output_dir/%(title)s_[%(id)s].%(ext)s" \
    "$yt_url"

  local exit_code=$?

  echo ""
  if [[ $exit_code -eq 0 ]]; then
    log_success "Download complete!"
    log_info "Saved to: $output_dir"
    am broadcast -a android.intent.action.MEDIA_SCANNER_SCAN_FILE -d "file://$output_dir" 2>/dev/null || true
  else
    log_error "Download failed (exit code: $exit_code)"
  fi
}

handle_youtube() {
  local url="$1"

  log_info "YouTube Downloader"
  echo "-------------------"

  require_cmds yt-dlp ffmpeg

  local video_id
  video_id=$(yt_extract_video_id "$url")

  if [[ -z "$video_id" ]]; then
    log_error "Could not extract video ID"
    wait_exit 1
  fi

  log_info "Video ID: $video_id"

  local is_short_video="false"
  yt_is_short "$url" "$video_id" && is_short_video="true"

  yt_download "$video_id" "$is_short_video"
}

# ==============================================================================
# Tidal
# ==============================================================================

handle_tidal() {
  local url="$1"

  log_info "Tidal Downloader"
  echo "-------------------"

  log_warn "Tidal support not yet implemented"
  log_info "URL: $url"
}

# ==============================================================================
# Main
# ==============================================================================

main() {
  local input="${1:-}"

  echo ""

  check_storage

  if [[ -z "$input" ]]; then
    log_error "No input provided"
    wait_exit 1
  fi

  log_info "Input: $input"

  # Input type dispatch
  case "$input" in
  http://* | https://*)
    # URL routing
    case "$input" in
    *youtube.com* | *youtu.be*)
      handle_youtube "$input"
      ;;
    *tidal.com*)
      handle_tidal "$input"
      ;;
    *)
      log_error "Unsupported URL: $input"
      log_info "Supported: YouTube, Tidal"
      wait_exit 1
      ;;
    esac
    ;;
  *)
    log_error "Unknown input type"
    log_info "Expected: URL (http:// or https://)"
    wait_exit 1
    ;;
  esac

  wait_exit 0
}

main "$@"
