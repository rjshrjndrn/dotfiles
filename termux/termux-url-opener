#!/data/data/com.termux/files/usr/bin/bash
# vim: set ft=bash:
#
# termux-url-opener - Receive shared YouTube URLs and download in max resolution
#
# Setup:
#   pkg update && pkg install yt-dlp ffmpeg
#   termux-setup-storage
#   mkdir -p ~/bin
#   cp termux-url-opener ~/bin/
#   chmod +x ~/bin/termux-url-opener
#
# Usage: Share any YouTube link to Termux from any app
#

set -uo pipefail

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

# Output directories
BASE_DIR="$HOME/storage/shared/Download/termux/yt"
SHORTS_DIR="$BASE_DIR/shorts"
VIDEOS_DIR="$BASE_DIR/videos"

log_info()    { echo -e "${BLUE}[*]${NC} $1"; }
log_success() { echo -e "${GREEN}[+]${NC} $1"; }
log_warn()    { echo -e "${YELLOW}[!]${NC} $1"; }
log_error()   { echo -e "${RED}[-]${NC} $1" >&2; }

# Check dependencies
check_deps() {
    local missing=()
    for cmd in yt-dlp ffmpeg; do
        command -v "$cmd" &>/dev/null || missing+=("$cmd")
    done

    if [[ ${#missing[@]} -gt 0 ]]; then
        log_error "Missing: ${missing[*]}"
        log_info "Run: pkg install yt-dlp ffmpeg"
        read -p "Press Enter to exit..."
        exit 1
    fi

    if [[ ! -d "$HOME/storage/shared" ]]; then
        log_error "Storage not accessible"
        log_info "Run: termux-setup-storage"
        read -p "Press Enter to exit..."
        exit 1
    fi

    # Create output directories
    mkdir -p "$SHORTS_DIR" "$VIDEOS_DIR"
}

# Clean URL and extract video ID
extract_video_id() {
    local url="$1"
    local video_id=""

    # Strip tracking params (?si=, &si=, ?feature=share, etc.)
    url="${url%%\?si=*}"
    url="${url%%&si=*}"
    url="${url%%\?feature=*}"
    url="${url%%&feature=*}"

    # Extract ID from various YouTube URL formats
    if [[ "$url" =~ youtu\.be/([a-zA-Z0-9_-]{11}) ]]; then
        video_id="${BASH_REMATCH[1]}"
    elif [[ "$url" =~ youtube\.com/shorts/([a-zA-Z0-9_-]{11}) ]]; then
        video_id="${BASH_REMATCH[1]}"
    elif [[ "$url" =~ youtube\.com/watch\?v=([a-zA-Z0-9_-]{11}) ]]; then
        video_id="${BASH_REMATCH[1]}"
    elif [[ "$url" =~ [?&]v=([a-zA-Z0-9_-]{11}) ]]; then
        video_id="${BASH_REMATCH[1]}"
    elif [[ "$url" =~ youtube\.com/v/([a-zA-Z0-9_-]{11}) ]]; then
        video_id="${BASH_REMATCH[1]}"
    elif [[ "$url" =~ youtube\.com/embed/([a-zA-Z0-9_-]{11}) ]]; then
        video_id="${BASH_REMATCH[1]}"
    fi

    echo "$video_id"
}

# Detect if URL is a YouTube Short
is_short() {
    local url="$1"
    local video_id="$2"

    # Check URL pattern first (fastest)
    [[ "$url" =~ youtube\.com/shorts/ ]] && return 0

    # Check duration via yt-dlp (shorts are <= 60s)
    local duration
    duration=$(yt-dlp --no-warnings --print duration "https://www.youtube.com/watch?v=$video_id" 2>/dev/null || echo "999")

    [[ "$duration" =~ ^[0-9]+(\.[0-9]+)?$ ]] && [[ "${duration%.*}" -le 60 ]] && return 0

    return 1
}

# Download video
download() {
    local video_id="$1"
    local is_short="$2"
    local output_dir
    local yt_url="https://www.youtube.com/watch?v=$video_id"

    if [[ "$is_short" == "true" ]]; then
        output_dir="$SHORTS_DIR"
        log_info "Type: YouTube Short"
    else
        output_dir="$VIDEOS_DIR"
        log_info "Type: Regular Video"
    fi

    # Fetch title
    local title
    title=$(yt-dlp --no-warnings --print title "$yt_url" 2>/dev/null || echo "Unknown")
    log_info "Title: $title"

    echo ""
    log_info "Downloading in max resolution..."
    echo ""

    yt-dlp \
        --no-playlist \
        -f "bestvideo[ext=mp4]+bestaudio[ext=m4a]/bestvideo+bestaudio/best" \
        --merge-output-format mp4 \
        --embed-thumbnail \
        --embed-metadata \
        --restrict-filenames \
        --no-mtime \
        --progress \
        -o "$output_dir/%(title)s_[%(id)s].%(ext)s" \
        "$yt_url"

    local exit_code=$?

    echo ""
    if [[ $exit_code -eq 0 ]]; then
        log_success "Download complete!"
        log_info "Saved to: $output_dir"

        # Trigger media scan
        am broadcast -a android.intent.action.MEDIA_SCANNER_SCAN_FILE -d "file://$output_dir" 2>/dev/null || true
    else
        log_error "Download failed (exit code: $exit_code)"
    fi

    echo ""
    read -p "Press Enter to close..."
}

# Main
main() {
    local url="${1:-}"

    echo ""
    log_info "YouTube Downloader"
    echo "-------------------"

    check_deps

    if [[ -z "$url" ]]; then
        log_error "No URL provided"
        read -p "Press Enter to exit..."
        exit 1
    fi

    log_info "URL: $url"

    # Check if it's a YouTube URL
    if [[ ! "$url" =~ (youtube\.com|youtu\.be) ]]; then
        log_error "Not a YouTube URL"
        read -p "Press Enter to exit..."
        exit 1
    fi

    local video_id
    video_id=$(extract_video_id "$url")

    if [[ -z "$video_id" ]]; then
        log_error "Could not extract video ID from URL"
        read -p "Press Enter to exit..."
        exit 1
    fi

    log_info "Video ID: $video_id"

    local is_short_video="false"
    is_short "$url" "$video_id" && is_short_video="true"

    download "$video_id" "$is_short_video"
}

main "$@"

