# ZSA Technology Labs — Voyager
# Based on: https://github.com/zsa/wally/wiki/Linux-install

# Oryx web flashing and live training
KERNEL=="hidraw*", ATTRS{idVendor}=="3297", MODE="0664", GROUP="input", TAG+="uaccess"

# WebUSB live training (firmware < v21)
SUBSYSTEM=="usb", ATTRS{idVendor}=="3297", MODE="0664", GROUP="input", TAG+="uaccess"

# Keymapp flashing (DFU mode)
SUBSYSTEMS=="usb", ATTRS{idVendor}=="3297", MODE:="0666", SYMLINK+="ignition_dfu", GROUP="input", TAG+="uaccess"
