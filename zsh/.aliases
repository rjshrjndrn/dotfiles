###############################################################################
# Utilities & Web
###############################################################################

function sendfile() {
  local timeout=300 token file

  while [[ $# -gt 0 ]]; do
    case "$1" in
    -t)
      timeout="$2"
      shift 2
      ;;
    *) break ;;
    esac
  done

  if [[ $# -eq 1 ]]; then
    token="$(openssl rand -hex 10)"
    file="$1"
  elif [[ $# -eq 2 ]]; then
    file="$1"
    token="$2"
  else
    echo "Usage: sendfile [-t timeout] <file> [token]"
    return 1
  fi
  echo "curl https://send.rjsh.me/${token} -o $(basename "$file")"
  curl -X POST "https://send.rjsh.me/${token}?timeout=${timeout}" --data-binary @"$file"
}

function uf() {
  url=$(echo $1 | rev | cut -d'/' -f 1 | rev)
  echo " curl --upload-file $url https://transfer.sh/$url -H 'Max-Downloads: 1' "
  curl --upload-file $url https://transfer.sh/$url -H 'Max-Downloads: 1'
}

