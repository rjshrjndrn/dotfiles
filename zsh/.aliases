# Misc / System
###############################################################################

alias yay='yay --sudoloop'
alias gw=greywall  # sandboxing tool for cli tools: https://github.com/GreyhavenHQ/greyproxy
alias go_build='go build -ldflags "-s -w"'
alias y=yazi
alias hc='atuin history -c'
alias stow='stow --no-folding'
