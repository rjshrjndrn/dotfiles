#######################################
# Clone a bare repo with repo name
# Usage: gclb gh:user/repo
#######################################
function gclb() {
  [[ $# -lt 1 ]] && echo "Usage: gclb [repo_url]" && return
  readonly repo_url="$1"
  shift
  readonly repo_name=$(basename "$repo_url")
  git clone --bare "$repo_url" "${repo_name}/.git" "$@"
}

# crate git worktree with optional local branch/remote branch
function gwa() {
  [[ -z "$1" ]] &&
    echo "Usage: gwa [local_branch_name] [remote_branch_name] [folder_name]" &&
    return

  local branch=$1
  local remote=$2
  local folder=$3
  local toplevel

  # Check if bare repo, then create worktree dir
  if [[ $(git rev-parse --is-bare-repository) == "true" ]]; then
    echo bare repo
    # If bare repo, use current directory unless you're inside 'worktree/' dir
    # I keep all the branches in worktree/ directory
    toplevel=$(readlink -f .)
  else
    toplevel=$(git rev-parse --show-toplevel)/worktree
  fi
  # Check if local branch exists
  if ! git branch | grep "$branch"; then
    readonly arg="-b $branch"
  fi
  [[ -z $folder ]] || branch=$folder
  readonly command="git worktree add $arg $toplevel/$branch $remote"
  echo "$command"
  eval "$command"
  eval "gwc $branch" # Change to the new worktree directory
}

alias gwr='git worktree remove'
# alias gl='git log --graph --pretty=format:"%C(magenta)%h %C(white) %an  %ar%C(blue)  %D%n%s%n"'

#######################################
# git chekcout if not worktree, else cd to that dir
#######################################
function gwc() {
  if [[ -z "$1" ]]; then
    echo "Usage: gwc <branch_name>"
    return 1
  fi

  local branch="$1"
  local worktree_path

  # Check if the branch exists as a worktree
  worktree_path=$(git worktree list | grep "\[$branch\]" | cut -d' ' -f1)

  if [[ -n "$worktree_path" ]]; then
    echo "Switching to worktree: $worktree_path"
    cd "$worktree_path" || {
      echo "Failed to change directory to $worktree_path"
      return 1
    }
  else
    echo "Checking out branch: $branch"
    git checkout "$branch"
  fi
}

