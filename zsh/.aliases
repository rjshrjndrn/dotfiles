###############################################################################
# Git — Push / Pull
###############################################################################

alias gpl='git pull --rebase'
alias gplo='git pull --rebase origin heads/$(git rev-parse --abbrev-ref HEAD | rev | cut -d '/' -f1 | rev)'
alias gplr='git pull --rebase rjshrjndrn $(git rev-parse --abbrev-ref HEAD)'

function gpo() {
  args="$*"
  if [[ $args != "" ]]; then
    # Eval to expand variables with space. Else entire string will be taken as single string
    eval git push origin $args
  else
    git push origin $(git rev-parse --abbrev-ref HEAD)
  fi
}
alias gpof='gpo --force-with-lease'
alias gpr='git push rjshrjndrn $(git rev-parse --abbrev-ref HEAD)'
alias gpso='git push --set-upstream origin $(git rev-parse --abbrev-ref HEAD)'
alias gpsof='gpo --force-with-lease'
alias gpsr='git push --set-upstream rjshrjndrn HEAD:$(git rev-parse --abbrev-ref HEAD)'

###############################################################################
# Git — Worktree
###############################################################################

alias gwl='git worktree list'

#######################################
# Clone a bare repo with repo name
# Usage: gclb gh:user/repo
#######################################
function gclb() {
  [[ $# -lt 1 ]] && echo "Usage: gclb [repo_url]" && return
  readonly repo_url="$1"
  shift
  readonly repo_name=$(basename "$repo_url")
  git clone --bare "$repo_url" "${repo_name}/.git" "$@"
}

# Create git worktree with optional local branch/remote branch
# Usage: gwa <local_branch> [folder_name] [-r ref]
#   gwa local              -> create branch 'local' from HEAD or existing ref
#   gwa local -r nh/work   -> create local branch 'local' tracking remote 'nh' branch 'work'
#   gwa local -r abc123    -> create branch 'local' from commit abc123
#   gwa feature            -> create branch 'feature' (auto-detect local/remote/new)
function gwa() {
  [[ -z "$1" ]] &&
    echo "Usage: gwa <local_branch> [folder_name] [-r remote[/remote_branch]] [-p path]" &&
    return

  local name=""
  local folder=""
  local remote_arg="" # raw value passed to -r, e.g. "nh/work" or "origin"
  local path_arg=""   # custom base path for worktree

  # Parse args
  while [[ $# -gt 0 ]]; do
    case $1 in
    -r | --remote)
      remote_arg="$2"
      shift 2
      ;;
    -p | --path)
      path_arg="$2"
      shift 2
      ;;
    *)
      # Positional: first is name, second is folder
      if [[ -z "$name" ]]; then
        name="$1"
      elif [[ -z "$folder" ]]; then
        folder="$1"
      fi
      shift
      ;;
    esac
  done

  [[ -z "$name" ]] && echo "Error: branch or tag name required" && return 1

  local toplevel

  # Check if bare repo, then create worktree dir
  if [[ -n "$path_arg" ]]; then
    toplevel=$(realpath "$path_arg")
  elif [[ $(git rev-parse --is-bare-repository) == "true" ]]; then
    # If bare repo, use current directory
    toplevel=$(readlink -f .)
  else
    # Use git-common-dir so we always resolve the main repo root,
    # even when called from inside a linked worktree.
    toplevel=$(realpath "$(git rev-parse --git-common-dir)/..")/worktree
  fi

  # If a worktree already exists for this branch name, just cd to it.
  # (This is what triggers: "fatal: '<name>' is already used by worktree ...")
  local existing_worktree
  existing_worktree=$(git worktree list 2>/dev/null | awk -v b="$name" '$0 ~ "\\["b"\\]" {print $1; exit}')
  if [[ -n "$existing_worktree" ]]; then
    gwc "$name"
    return
  fi

  local dir_name="${folder:-$name}"

  local commitish
  local -a args

  # If -r was given, treat remote_arg as the full remote ref to branch from.
  # remote_arg can be "remote/branch" (e.g. "nh/work") or just "remote" (falls
  # back to using $name as the remote branch).
  if [[ -n "$remote_arg" ]]; then
    # Split remote_arg into remote_name and remote_branch
    # If remote_arg contains '/', first component is remote, rest is branch.
    local remote_name remote_branch
    if [[ "$remote_arg" == */* ]]; then
      remote_name="${remote_arg%%/*}"
      remote_branch="${remote_arg#*/}"
    else
      remote_name="$remote_arg"
      remote_branch="$name"
    fi
    local commitish_candidate="$remote_name/$remote_branch"
    if git show-ref --verify --quiet "refs/remotes/$commitish_candidate"; then
      commitish="$commitish_candidate"
      args=(-b "$name")
    elif git show-ref --verify --quiet "refs/heads/$remote_branch"; then
      # In bare repos, fetched remote refs land under refs/heads/ not refs/remotes/
      commitish="$remote_branch"
      args=(-b "$name")
    elif git rev-parse --verify --quiet "$remote_arg^{commit}" >/dev/null 2>&1; then
      # Treat as a raw commit/ref (SHA, tag, etc.)
      commitish="$remote_arg"
      args=(-b "$name")
    else
      echo "Error: '$remote_arg' is not a valid remote ref or commit" && return 1
    fi
  # If it's a tag, create a detached worktree at that tag.
  elif git show-ref --tags --verify --quiet "refs/tags/$name"; then
    commitish="refs/tags/$name"
    args=(--detach)
  # If local branch exists, use it directly.
  elif git show-ref --verify --quiet "refs/heads/$name"; then
    commitish="$name"
    args=()
  # If remote branch exists on origin, create local tracking branch.
  elif git show-ref --verify --quiet "refs/remotes/origin/$name"; then
    commitish="origin/$name"
    args=(-b "$name")
  else
    # Branch doesn't exist anywhere, create new branch from current HEAD
    commitish="HEAD"
    args=(-b "$name")
  fi

  echo "git worktree add ${args[*]} $toplevel/$dir_name $commitish"
  git worktree add "${args[@]}" "$toplevel/$dir_name" "$commitish" || return

  # Change to the new worktree directory
  cd "$toplevel/$dir_name" || return
}

function gwr() {
  worktree=$1
  shift
  args=$*
  git worktree remove "$worktree" $args || true
  branch=$(basename "$worktree")
  echo $branch
  git branch -D "$branch"
}

#######################################
# cd to worktree by branch name or folder name
# 1. check if branch exists as worktree
# 2. if not, check if folder name matches (for detached HEAD/tags)
# 3. else error
#######################################
function gwc() {
  if [[ -z "$1" ]]; then
    echo "Usage: gwc <branch_or_folder>"
    return 1
  fi

  local name="$1"
  local worktree_path

  # check if branch exists as a worktree
  local matches
  matches=$(git worktree list | grep "\[$name\]" | cut -d' ' -f1)

  # if not found, check by folder name (for detached HEAD like tags)
  if [[ -z "$matches" ]]; then
    matches=$(git worktree list | awk -v name="$name" '{
      n = split($1, parts, "/")
      if (parts[n] == name) print $1
    }')
  fi

  local count=$(echo "$matches" | grep -c .)
  if ((count > 1)); then
    echo "Multiple worktrees match '$name':"
    local i=1
    while IFS= read -r line; do
      echo "  $i) $line"
      ((i++))
    done <<<"$matches"
    echo -n "Select [1-$count]: "
    local choice
    read -r choice
    if [[ "$choice" -ge 1 && "$choice" -le "$count" ]] 2>/dev/null; then
      worktree_path=$(echo "$matches" | sed -n "${choice}p")
    else
      echo "Invalid selection"
      return 1
    fi
  else
    worktree_path="$matches"
  fi

  if [[ -n "$worktree_path" ]]; then
    echo "Switching to worktree: $worktree_path"
    cd "$worktree_path" || {
      echo "Failed to change directory to $worktree_path"
      return 1
    }
  else
    echo "Error: '$name' is not a worktree branch or folder"
    return 1
  fi
}

function tdg() {
  directory=$(realpath "$(git rev-parse --git-common-dir)/../")
  td -w "$directory" $@
}

