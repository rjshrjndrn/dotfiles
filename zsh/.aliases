###############################################################################
# SSH & Remote Access
###############################################################################

function sk() {
  local org=${1:-curr}
  eval $(ssh-agent -s) >/dev/null
  find ~/.cred/${org} -maxdepth 1 -type f -iname "*.pem" -exec ssh-add {} \; &>/dev/null
}

alias ssh='ssh -A'
alias uptermwss='upterm host --server wss://uptermd.upterm.dev'
alias nssh='ssh -o "UserKnownHostsFile /dev/null" -o "StrictHostKeyChecking false"'

function nscp() {
  local user=$1
  if [[ $# -eq 0 ]]; then
    echo "Usage: nscp <source> <destination>"
    return 1
  fi
  scp -o "UserKnownHostsFile /dev/null" -o "StrictHostKeyChecking false" "${user}@${*}"
}

nmosh() {
  mosh --ssh='ssh -o "UserKnownHostsFile /dev/null" -o "StrictHostKeyChecking false"' -p 60001 "$1"
}

nsr() { nssh rajeshr@$1 }
nsu() { nssh ubuntu@$1 }
nso() { nssh ops@$1 }

############################################
# ssh into dedicated server using Tailscale
# If arg given: ssh that as name
# Else: list all instances via fzf
############################################
function nsud() {
  local name=$1
  if [[ -n "$name" ]]; then
    local ip
    ip=$(ts status | grep "$1" | awk '{print $1}')
    nsu "$ip"
    return
  fi
  nsu "$(ts status | fzf | awk '{print $1}')"
}

