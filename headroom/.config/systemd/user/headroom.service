# stow headroom && systemctl --user daemon-reload
# systemctl --user enable --now headroom.service

[Unit]
Description=Headroom LLM context optimization proxy
Documentation=https://github.com/headroom-ai/headroom
After=network-online.target
Wants=network-online.target

[Service]
Environment=HEADROOM_ROLLOUT_CHANNEL=canary
ExecStart=%h/.local/share/mise/shims/headroom proxy \
    --mode token \
    --code-aware \
    --intercept-tool-results \
    --no-telemetry \
    --lossless \
    --no-rate-limit
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
